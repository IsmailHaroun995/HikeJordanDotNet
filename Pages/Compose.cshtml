@page "/compose"
@model ComposeModel
@{
    ViewData["Title"] = "New post";
}

<div class="form-page page-shell">
    <div class="form-card">
        <h1>@T("Share a trip")</h1>
        <p class="form-sub">@T("Post a trip report, a photo, or a tip for the community.")</p>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="form-error">@Model.Error</div>
        }

        <form method="post" enctype="multipart/form-data" class="stack-form">
            <div class="field char-count-wrap">
                <label for="Body">@T("What's the story?")</label>
                <textarea id="Body" name="Body" rows="5" maxlength="2000" class="form-control" placeholder="@T("Describe the trail, conditions, tips…")" required>@Model.Body</textarea>
                <span class="char-count" aria-hidden="true"></span>
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="Region">@T("Region")</label>
                    <select id="Region" name="Region" class="form-select">
                        <option value="">@T("Select a region")</option>
                        @foreach (var r in Community.Regions)
                        {
                            <option value="@r" selected="@(Model.Region == r)">@T(r)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="LocationName">@T("Specific place (optional)")</label>
                    <input id="LocationName" name="LocationName" value="@Model.LocationName" class="form-control" placeholder="@T("e.g. Sunset Ridge")" />
                </div>
            </div>

            <div class="field">
                <label>@T("Hike stats (optional)")</label>
                <div class="stat-inputs">
                    <div class="stat-input">
                        <input name="DistanceKm" type="number" step="0.1" min="0" value="@Model.DistanceKm" class="form-control" placeholder="0" />
                        <span>@T("km")</span>
                    </div>
                    <div class="stat-input">
                        <input name="ElevationGainM" type="number" step="1" min="0" value="@Model.ElevationGainM" class="form-control" placeholder="0" />
                        <span>@T("m elev")</span>
                    </div>
                    <div class="stat-input">
                        <input name="DurationMinutes" type="number" step="1" min="0" value="@Model.DurationMinutes" class="form-control" placeholder="0" />
                        <span>@T("min")</span>
                    </div>
                </div>
            </div>

            <div class="field">
                <label for="Image">@T("Photo (optional)")</label>
                <input id="Image" name="Image" type="file" accept="image/*" class="form-control" />
            </div>

            <div class="form-buttons">
                <a class="btn secondary-action" href="/">@T("Cancel")</a>
                <button type="submit" class="btn primary-action">@T("Post")</button>
            </div>
        </form>
    </div>
</div>
