@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="form-page page-shell">
    <div class="form-card" style="text-align:center">
        <h1>Something went wrong</h1>
        <p class="form-sub">We hit an unexpected error and our team has been notified. Try heading back to the feed, or refresh the page.</p>
        @if (Model.ShowRequestId)
        {
            <p class="error-request-id">Request ID: <code>@Model.RequestId</code></p>
        }
        <div class="form-buttons" style="justify-content:center">
            <a class="btn primary-action" href="/">Back to feed</a>
            <a class="btn secondary-action" href="/explore">Explore</a>
        </div>
    </div>
</div>
