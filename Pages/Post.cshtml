@page "/post/{id:int}"
@model PostModel
@{
    var p = Model.Entry;
    ViewData["Title"] = $"{p.Author?.Name} on {(string.IsNullOrEmpty(p.Region) ? "HikeJordan" : p.Region)}";
    ViewData["Description"] = p.Body.Length > 150 ? p.Body[..147] + "…" : p.Body;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var returnUrl = $"/post/{p.Id}";
}

<div class="post-detail-layout page-shell">
    <main class="post-detail">
        <a class="back-link" href="javascript:history.back()">@T("← Back")</a>

        <article class="post-card post-card-detail">
            <header class="post-head">
                <a class="post-avatar" href="/u/@p.Author?.Username">
                    @if (!string.IsNullOrEmpty(p.Author?.AvatarUrl))
                    {
                        <img src="@p.Author.AvatarUrl" alt="@p.Author.Name" />
                    }
                    else
                    {
                        <span class="avatar-fallback">@Community.Initials(p.Author?.Name ?? "?")</span>
                    }
                </a>
                <div class="post-head-meta">
                    <a class="post-author" href="/u/@p.Author?.Username">@p.Author?.Name</a>
                    <span class="post-sub">
                        <a href="/u/@p.Author?.Username">@@@p.Author?.Username</a>
                        <span class="dot">·</span>
                        <span title="@p.CreatedAtUtc.ToString("f")">@Community.TimeAgo(p.CreatedAtUtc)</span>
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(p.Region))
                {
                    <a class="post-region-chip" href="/explore?region=@Uri.EscapeDataString(p.Region)">@p.Region</a>
                }
            </header>

            <p class="post-body post-body-full">@p.Body</p>

            @if (!string.IsNullOrEmpty(p.LocationName))
            {
                <div class="post-location">📍 @p.LocationName</div>
            }

            @if (!string.IsNullOrEmpty(p.ImageUrl))
            {
                <div class="post-image-wrap post-image-full">
                    <img src="@p.ImageUrl" alt="Photo from @p.Region" />
                </div>
            }

            <footer class="post-actions">
                @if (isAuth)
                {
                    <form method="post" asp-page-handler="Like" class="inline-form">
                        <input type="hidden" name="postId" value="@p.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="post-action @(Model.Liked ? "liked" : "")">
                            <span class="action-icon">@(Model.Liked ? "♥" : "♡")</span>
                            <span>@p.LikeCount @T("likes")</span>
                        </button>
                    </form>
                }
                else
                {
                    <a class="post-action" href="/Login"><span class="action-icon">♡</span><span>@p.LikeCount @T("likes")</span></a>
                }
                <span class="post-action static"><span class="action-icon">💬</span><span>@p.CommentCount @T("comments")</span></span>
            </footer>
        </article>

        <section class="comments-section">
            <h2 class="comments-title">@T("Comments")</h2>

            @if (isAuth)
            {
                <form method="post" asp-page-handler="Comment" asp-route-id="@p.Id" class="comment-form">
                    <div class="char-count-wrap">
                        <textarea name="body" rows="2" maxlength="1000" placeholder="@T("Add a comment…")" class="form-control" required></textarea>
                        <span class="char-count" aria-hidden="true"></span>
                    </div>
                    <button type="submit" class="btn primary-action">@T("Comment")</button>
                </form>
            }
            else
            {
                <p class="comment-signin"><a href="/Login">@T("Sign in")</a> @T("to join the conversation.")</p>
            }

            @if (Model.Comments.Count == 0)
            {
                <p class="empty-state">@T("No comments yet.")</p>
            }
            else
            {
                <ul class="comment-list">
                    @foreach (var c in Model.Comments)
                    {
                        <li class="comment-item">
                            <a class="comment-avatar" href="/u/@c.Author?.Username">
                                @if (!string.IsNullOrEmpty(c.Author?.AvatarUrl))
                                {
                                    <img src="@c.Author.AvatarUrl" alt="@c.Author.Name" />
                                }
                                else
                                {
                                    <span class="avatar-fallback">@Community.Initials(c.Author?.Name ?? "?")</span>
                                }
                            </a>
                            <div class="comment-bubble">
                                <div class="comment-meta">
                                    <a href="/u/@c.Author?.Username"><strong>@c.Author?.Name</strong></a>
                                    <span class="comment-time">@Community.TimeAgo(c.CreatedAtUtc)</span>
                                </div>
                                <p>@c.Body</p>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </main>
</div>
