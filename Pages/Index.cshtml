@page
@model IndexModel
@{
    ViewData["Title"] = "Feed";
    ViewData["Description"] = "HikeJordan — the community for Jordan's outdoor explorers. Share trips, follow hikers, discover new places.";
    ViewData["LikedPostIds"] = Model.LikedPostIds;
    var isAuth = User.Identity?.IsAuthenticated == true;
}

<div class="feed-layout page-shell">
    <main class="feed-main">
        @if (isAuth)
        {
            <div class="feed-tabs">
                <a class="feed-tab @(Model.Tab == "latest" ? "active" : "")" href="/?tab=latest">Latest</a>
                <a class="feed-tab @(Model.Tab == "following" ? "active" : "")" href="/?tab=following">Following</a>
            </div>

            <a class="compose-prompt" href="/compose">
                <span class="compose-avatar">
                    @{ var meAvatar = User.FindFirst("avatar")?.Value; }
                    @if (!string.IsNullOrEmpty(meAvatar))
                    {
                        <img src="@meAvatar" alt="You" />
                    }
                    else
                    {
                        <span class="avatar-fallback">@Community.Initials(User.Identity?.Name ?? "?")</span>
                    }
                </span>
                <span class="compose-placeholder">Share a trip or a tip…</span>
                <span class="compose-go">Post</span>
            </a>
        }
        else
        {
            <section class="feed-welcome">
                <h1>Jordan's outdoor community</h1>
                <p>Share your trips, follow other hikers, and discover new places through the people who've been there.</p>
                <div class="welcome-actions">
                    <a class="btn primary-action" href="/Register">Join the community</a>
                    <a class="btn secondary-action" href="/explore">Explore posts</a>
                </div>
            </section>
        }

        @if (Model.Posts.Count == 0)
        {
            <div class="empty-state">
                @if (Model.Tab == "following")
                {
                    <p>Your following feed is empty. <a href="/explore">Find people to follow →</a></p>
                }
                else
                {
                    <p>No posts yet. Be the first to share something.</p>
                }
            </div>
        }
        else
        {
            <div class="post-feed">
                @foreach (var post in Model.Posts)
                {
                    <partial name="_PostCard" model="post" />
                }
            </div>
        }
    </main>

    <aside class="feed-side">
        <div class="side-card">
            <div class="side-stat-row">
                <div class="side-stat"><strong>@Model.PostCount</strong><span>Posts</span></div>
                <div class="side-stat"><strong>@Model.MemberCount</strong><span>Members</span></div>
            </div>
            @if (!isAuth)
            {
                <a class="btn primary-action side-join" href="/Register">Create your profile</a>
            }
        </div>

        @if (isAuth && Model.SuggestedUsers.Count > 0)
        {
            <div class="side-card">
                <h3 class="side-title">Who to follow</h3>
                <ul class="suggest-list">
                    @foreach (var u in Model.SuggestedUsers)
                    {
                        <li class="suggest-row">
                            <a class="suggest-user" href="/u/@u.Username">
                                <span class="suggest-avatar">
                                    @if (!string.IsNullOrEmpty(u.AvatarUrl))
                                    {
                                        <img src="@u.AvatarUrl" alt="@u.Name" />
                                    }
                                    else
                                    {
                                        <span class="avatar-fallback">@Community.Initials(u.Name)</span>
                                    }
                                </span>
                                <span class="suggest-meta">
                                    <strong>@u.Name</strong>
                                    <span>@@@u.Username</span>
                                </span>
                            </a>
                            <form method="post" asp-page-handler="Follow" class="inline-form">
                                <input type="hidden" name="targetId" value="@u.Id" />
                                <input type="hidden" name="returnUrl" value="/?tab=@Model.Tab" />
                                <button type="submit" class="btn-follow-sm">Follow</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="side-card">
            <h3 class="side-title">Explore by region</h3>
            <div class="region-chips">
                @foreach (var r in Community.Regions.Take(8))
                {
                    <a class="region-chip" href="/explore?region=@Uri.EscapeDataString(r)">@r</a>
                }
            </div>
        </div>
    </aside>
</div>
