@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "HikeJordan — the community for Jordan's outdoor explorers. Share trips, follow hikers, log your hikes.";
    var isAuth = User.Identity?.IsAuthenticated == true;
}

<section class="hero2">
    <div class="hero2-inner page-shell">
        <span class="hero2-eyebrow">🏔 @T("Jordan's outdoor community")</span>
        <h1 class="hero2-title">@T("Explore Jordan, together.")</h1>
        <p class="hero2-sub">@T("Share your trips, follow other hikers, and discover new places through the people who've been there.")</p>
        <div class="welcome-actions">
            @if (isAuth)
            {
                <a class="btn primary-action" href="/explore">@T("Go to the feed")</a>
                <a class="btn hero2-ghost" href="/compose">@T("Share a hike")</a>
            }
            else
            {
                <a class="btn primary-action" href="/Register">@T("Join the community")</a>
                <a class="btn hero2-ghost" href="/explore">@T("Explore posts")</a>
            }
        </div>
    </div>
    <svg class="hero2-mountains" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true">
        <path fill="rgba(255,255,255,0.06)" d="M0,80 L240,30 L480,92 L720,18 L960,82 L1200,38 L1440,88 L1440,140 L0,140 Z" />
        <path fill="var(--paper)" d="M0,112 L180,72 L360,112 L540,62 L720,112 L900,70 L1080,112 L1260,76 L1440,110 L1440,140 L0,140 Z" />
    </svg>
</section>

<section class="page-shell home-stats">
    <div class="hstat">
        <span class="hstat-ico">🥾</span>
        <strong>@Model.PostCount</strong>
        <span>@T("Hikes")</span>
    </div>
    <div class="hstat">
        <span class="hstat-ico">👥</span>
        <strong>@Model.MemberCount</strong>
        <span>@T("Members")</span>
    </div>
    <div class="hstat">
        <span class="hstat-ico">📍</span>
        <strong>@Model.PlacesCount</strong>
        <span>@T("places")</span>
    </div>
</section>

<section class="page-shell home-section">
    <h2 class="home-h2 home-h2-center">@T("How it works")</h2>
    <div class="feature-grid">
        <div class="feature-card">
            <span class="feature-ico">📸</span>
            <h3>@T("Share your hikes")</h3>
            <p>@T("Post trip reports, photos, and stats — distance, elevation and time — from every adventure.")</p>
        </div>
        <div class="feature-card">
            <span class="feature-ico">🧭</span>
            <h3>@T("Follow the community")</h3>
            <p>@T("Connect with hikers and groups, and discover new places through the people who've been there.")</p>
        </div>
        <div class="feature-card">
            <span class="feature-ico">🏅</span>
            <h3>@T("Earn badges & rank up")</h3>
            <p>@T("Collect a badge for every place you visit and climb the community distance leaderboard.")</p>
        </div>
    </div>
</section>

@if (Model.PopularRegions.Count > 0)
{
    <section class="page-shell home-section">
        <div class="home-section-head">
            <h2 class="home-h2">@T("Popular regions")</h2>
            <a class="map-link-btn" href="/explore">@T("Browse all") →</a>
        </div>
        <div class="region-card-grid">
            @foreach (var r in Model.PopularRegions)
            {
                <a class="region-card" href="/explore?region=@Uri.EscapeDataString(r.Region)">
                    <span class="region-card-emoji">@Community.RegionEmoji(r.Region)</span>
                    <strong>@T(r.Region)</strong>
                    <span class="region-card-count">@r.Count @T("posts")</span>
                </a>
            }
        </div>
    </section>
}

@if (Model.TopHikers.Count > 0)
{
    <section class="page-shell home-section">
        <div class="home-section-head">
            <h2 class="home-h2">🏆 @T("Top hikers")</h2>
            <a class="map-link-btn" href="/leaderboard">@T("See full leaderboard") →</a>
        </div>
        <ol class="leaderboard">
            @{ var rank = 0; }
            @foreach (var h in Model.TopHikers)
            {
                rank++;
                var medal = rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => rank.ToString() };
                <li class="lb-row lb-top">
                    <span class="lb-rank">@medal</span>
                    <a class="lb-user" href="/u/@h.User.Username">
                        <span class="lb-avatar">
                            @if (!string.IsNullOrEmpty(h.User.AvatarUrl))
                            {
                                <img src="@h.User.AvatarUrl" alt="@h.User.Name" />
                            }
                            else
                            {
                                <span class="avatar-fallback">@Community.Initials(h.User.Name)</span>
                            }
                        </span>
                        <span class="lb-meta"><strong>@h.User.Name</strong></span>
                    </a>
                    <span class="lb-distance"><strong>@h.Distance.ToString("0.#")</strong> @T("km")</span>
                </li>
            }
        </ol>
    </section>
}

<div style="height:56px"></div>
