@page
@model AdminModel
@{
    ViewData["Title"] = "Admin";
}

<div class="admin-page page-shell">
    <h1>Moderation</h1>

    <div class="admin-stats">
        <div class="admin-stat"><strong>@Model.TotalPosts</strong><span>Posts</span></div>
        <div class="admin-stat"><strong>@Model.TotalUsers</strong><span>Members</span></div>
        <div class="admin-stat"><strong>@Model.TotalComments</strong><span>Comments</span></div>
    </div>

    <section class="admin-section">
        <h2>Posts</h2>
        <div class="table-scroll">
            <table class="admin-table">
                <thead>
                    <tr><th>Author</th><th>Region</th><th>Post</th><th>When</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Posts)
                    {
                        <tr class="@(p.IsHidden ? "row-hidden" : "")">
                            <td>@p.Author?.Name</td>
                            <td>@p.Region</td>
                            <td class="cell-clip"><a href="/post/@p.Id">@(p.Body.Length > 60 ? p.Body[..57] + "…" : p.Body)</a></td>
                            <td>@Community.TimeAgo(p.CreatedAtUtc)</td>
                            <td>@(p.IsHidden ? "Hidden" : "Visible")</td>
                            <td class="cell-actions">
                                <form method="post" asp-page-handler="ToggleHide" class="inline-form">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn-mini">@(p.IsHidden ? "Unhide" : "Hide")</button>
                                </form>
                                <form method="post" asp-page-handler="DeletePost" class="inline-form" onsubmit="return confirm('Delete this post permanently?');">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn-mini danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-section">
        <h2>Members</h2>
        <div class="table-scroll">
            <table class="admin-table">
                <thead>
                    <tr><th>Name</th><th>Username</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td><a href="/u/@u.Username">@u.Name</a></td>
                            <td>@@@u.Username</td>
                            <td class="cell-clip">@u.Email</td>
                            <td>@u.Role</td>
                            <td>@u.ApprovalStatus</td>
                            <td class="cell-actions">
                                @if (u.Role != AppConstants.Roles.Admin)
                                {
                                    <form method="post" asp-page-handler="ToggleUser" class="inline-form">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn-mini">
                                            @(u.ApprovalStatus == AppConstants.AccountStatus.Disabled ? "Enable" : "Disable")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
