@page "/explore"
@model ExploreModel
@{
    ViewData["Title"] = Model.Region is not null ? $"{Model.Region}" : T("Explore");
    ViewData["Description"] = "Explore trip reports and photos from across Jordan's outdoors.";
    ViewData["LikedPostIds"] = Model.LikedPostIds;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var qs = Model.Region is not null ? $"&region={Uri.EscapeDataString(Model.Region)}" : "";
}

<div class="explore-header">
    <div class="page-shell">
        <h1>@T("Explore")</h1>
        <form class="explore-search" method="get" action="/explore">
            <input type="search" name="q" value="@Model.Query" placeholder="@T("Search posts, places, people…")" class="form-control" />
            <button type="submit" class="btn primary-action">@T("Search")</button>
        </form>
        <div class="region-chips explore-chips">
            <a class="region-chip @(Model.Region is null ? "active" : "")" href="/explore">@T("All")</a>
            @foreach (var r in Community.Regions)
            {
                <a class="region-chip @(Model.Region == r ? "active" : "")" href="/explore?region=@Uri.EscapeDataString(r)">@Community.RegionEmoji(r) @T(r)</a>
            }
        </div>
    </div>
</div>

<div class="feed-layout page-shell">
    <main class="feed-main">
        @if (Model.ShowOnboarding)
        {
            var done = (Model.StepPhoto ? 1 : 0) + (Model.StepBio ? 1 : 0) + (Model.StepPost ? 1 : 0) + (Model.StepFollow ? 1 : 0);
            <section class="onboard-card">
                <div class="onboard-head">
                    <div>
                        <h3>@T("Get started")</h3>
                        <span class="onboard-progress">@done / 4 @T("done")</span>
                    </div>
                    <form method="post" asp-page-handler="DismissOnboarding" class="inline-form">
                        <button type="submit" class="onboard-dismiss" aria-label="@T("Dismiss")">✕</button>
                    </form>
                </div>
                <ul class="onboard-steps">
                    <li class="@(Model.StepPhoto ? "step-done" : "")">
                        <span class="step-check">@(Model.StepPhoto ? "✓" : "○")</span>
                        @if (Model.StepPhoto) { <span>@T("Add a profile photo")</span> } else { <a href="/settings">@T("Add a profile photo")</a> }
                    </li>
                    <li class="@(Model.StepBio ? "step-done" : "")">
                        <span class="step-check">@(Model.StepBio ? "✓" : "○")</span>
                        @if (Model.StepBio) { <span>@T("Write a short bio")</span> } else { <a href="/settings">@T("Write a short bio")</a> }
                    </li>
                    <li class="@(Model.StepPost ? "step-done" : "")">
                        <span class="step-check">@(Model.StepPost ? "✓" : "○")</span>
                        @if (Model.StepPost) { <span>@T("Share your first hike")</span> } else { <a href="/compose">@T("Share your first hike")</a> }
                    </li>
                    <li class="@(Model.StepFollow ? "step-done" : "")">
                        <span class="step-check">@(Model.StepFollow ? "✓" : "○")</span>
                        <span>@T("Follow 3 hikers")</span>
                    </li>
                </ul>
            </section>
        }

        @if (isAuth)
        {
            <a class="compose-prompt" href="/compose">
                <span class="compose-avatar">
                    @{ var meAvatar = User.FindFirst("avatar")?.Value; }
                    @if (!string.IsNullOrEmpty(meAvatar))
                    {
                        <img src="@meAvatar" alt="You" />
                    }
                    else
                    {
                        <span class="avatar-fallback">@Community.Initials(User.Identity?.Name ?? "?")</span>
                    }
                </span>
                <span class="compose-placeholder">@T("Share a trip or a tip…")</span>
                <span class="compose-go">@T("Post")</span>
            </a>

            <div class="feed-tabs">
                <a class="feed-tab @(Model.Tab == "latest" ? "active" : "")" href="/explore?tab=latest@(qs)">@T("Latest")</a>
                <a class="feed-tab @(Model.Tab == "following" ? "active" : "")" href="/explore?tab=following@(qs)">@T("Following")</a>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Query) && Model.People.Count > 0)
        {
            <div class="side-card">
                <h3 class="side-title">@T("People")</h3>
                <ul class="suggest-list">
                    @foreach (var u in Model.People)
                    {
                        <li class="suggest-row">
                            <a class="suggest-user" href="/u/@u.Username">
                                <span class="suggest-avatar">
                                    @if (!string.IsNullOrEmpty(u.AvatarUrl)) { <img src="@u.AvatarUrl" alt="@u.Name" /> }
                                    else { <span class="avatar-fallback">@Community.Initials(u.Name)</span> }
                                </span>
                                <span class="suggest-meta"><strong>@u.Name</strong><span>@@@u.Username</span></span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Model.Posts.Count == 0)
        {
            <div class="empty-state">
                @if (Model.Tab == "following")
                {
                    <p>@T("Your following feed is empty.") <a href="/explore">@T("Find people to follow →")</a></p>
                }
                else
                {
                    <p>@T("No posts found.")</p>
                }
            </div>
        }
        else
        {
            <div class="post-feed">
                @foreach (var post in Model.Posts)
                {
                    <partial name="_PostCard" model="post" />
                }
            </div>
        }
    </main>

    <aside class="feed-side">
        @if (Model.SuggestedUsers.Count > 0)
        {
            <div class="side-card">
                <h3 class="side-title">@T("Who to follow")</h3>
                <ul class="suggest-list">
                    @foreach (var u in Model.SuggestedUsers)
                    {
                        <li class="suggest-row">
                            <a class="suggest-user" href="/u/@u.Username">
                                <span class="suggest-avatar">
                                    @if (!string.IsNullOrEmpty(u.AvatarUrl)) { <img src="@u.AvatarUrl" alt="@u.Name" /> }
                                    else { <span class="avatar-fallback">@Community.Initials(u.Name)</span> }
                                </span>
                                <span class="suggest-meta"><strong>@u.Name</strong><span>@@@u.Username</span></span>
                            </a>
                            @if (isAuth)
                            {
                                <form method="post" asp-page-handler="Follow" class="inline-form">
                                    <input type="hidden" name="targetId" value="@u.Id" />
                                    <input type="hidden" name="returnUrl" value="/explore" />
                                    <button type="submit" class="btn-follow-sm">@T("Follow")</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (Model.TrendingRegions.Count > 0)
        {
            <div class="side-card">
                <h3 class="side-title">@T("Trending regions")</h3>
                <ul class="trending-list">
                    @foreach (var t in Model.TrendingRegions)
                    {
                        <li>
                            <a href="/explore?region=@Uri.EscapeDataString(t.Region)">
                                <span>@Community.RegionEmoji(t.Region) @T(t.Region)</span>
                                <span class="trending-count">@t.Count</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="side-card side-leaderboard">
            <a href="/leaderboard">🏆 @T("See the leaderboard")</a>
        </div>
    </aside>
</div>
