@page "{region?}"
@model HikesModel

<section class="destination-hero" style="--image:url('@Model.CoverImage')">
    <div class="container-fluid page-shell">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            @if (Model.DestinationInfo is not null)
            {
                <span>@Model.DestinationInfo.Name</span>
            }
            else
            {
                <span>All hikes</span>
            }
        </nav>
        <div class="destination-hero-copy">
            <span class="eyebrow">@(Model.DestinationInfo?.Name ?? "Jordan") hiking trips</span>
            @if (Model.DestinationInfo is not null)
            {
                <h1>Hiking in @Model.DestinationInfo.Name</h1>
                <p>Organized trips in @Model.DestinationInfo.Name led by verified local guides. Compare routes, dates and prices — book directly on WhatsApp.</p>
            }
            else
            {
                <h1>All hiking trips in Jordan</h1>
                <p>Browse every organized trip across Wadi Rum, Ajloun, Dana, Dead Sea, Wadi Mujib and more. Compare and book directly on WhatsApp.</p>
            }
        </div>
    </div>
</section>

<section class="section-block">
    <div class="container-fluid page-shell">
        @if (Model.Hikes.Count == 0)
        {
            <div class="empty-state">
                <strong>No upcoming trips here yet</strong>
                <p>Check back soon — organizers submit new trips regularly. You can also <a asp-page="/OrganizerSignup">list your own trip</a>.</p>
                <a class="btn primary-action" href="/">See all hikes</a>
            </div>
        }
        else
        {
            <div class="hike-grid">
                @foreach (var hike in Model.Hikes)
                {
                    var lifecycle = IndexModel.TripLifecycle(hike);
                    var lifecycleSlug = IndexModel.LifecycleSlug(lifecycle);
                    var coverUrl = !string.IsNullOrEmpty(hike.ImagePath) ? hike.ImagePath : IndexModel.ImageForRegion(hike.Region);
                    <article class="hike-card">
                        <a href="/hike/@hike.Id" class="card-img-wrap card-img-link">
                            <img src="@coverUrl" alt="@hike.Region hiking landscape" loading="lazy" />
                            <div class="card-img-badges">
                                <span class="diff-badge diff-@IndexModel.DifficultySlug(hike.Difficulty)">@hike.Difficulty</span>
                                <span class="price-badge">@(hike.Price == 0 ? "Free" : $"JD {hike.Price:0}")</span>
                            </div>
                            <span class="lifecycle-badge lifecycle-@lifecycleSlug">@lifecycle</span>
                        </a>
                        <div class="card-body">
                            <div class="card-kicker">@hike.Region</div>
                            <h2><a href="/hike/@hike.Id">@hike.Title</a></h2>
                            @if (!string.IsNullOrWhiteSpace(hike.Description))
                            {
                                <p>@hike.Description</p>
                            }
                            <dl class="quick-facts">
                                <div><dt>Date</dt><dd>@hike.DateLabel@(string.IsNullOrEmpty(hike.TimeLabel) ? "" : $" · {hike.TimeLabel}")</dd></div>
                                <div><dt>Duration</dt><dd>@(hike.DurationHours.HasValue ? $"{hike.DurationHours}h" : "—")@(hike.DistanceKm.HasValue ? $" · {hike.DistanceKm}km" : "")</dd></div>
                                <div><dt>Spots</dt><dd class="@(hike.SpotsLeft <= 3 ? "spots-critical" : hike.SpotsLeft <= 6 ? "spots-low" : "spots-ok")">@hike.SpotsLeft left</dd></div>
                                <div><dt>Organizer</dt><dd>@hike.Organizer</dd></div>
                            </dl>
                            <div class="card-actions">
                                <a class="btn secondary-action" href="/hike/@hike.Id">View details</a>
                                @if (lifecycle != "Completed")
                                {
                                    <a class="btn whatsapp-button" href="@Model.WhatsAppBookingUrl(hike.WhatsApp, hike.Title)" target="_blank" rel="noopener noreferrer">Book on WhatsApp</a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
