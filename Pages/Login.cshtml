@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-page page-shell">
    <div class="auth-card">
        <h1>@T("Welcome back")</h1>
        <p class="auth-sub">@T("Sign in to your HikeJordan account.")</p>

        @if (Model.NeedsVerification)
        {
            <div class="form-error">
                @T("Please verify your email before signing in.")
                <form method="post" asp-page="/RegisterConfirmation" asp-page-handler="Resend" style="margin-top:8px">
                    <input type="hidden" name="email" value="@Model.UnverifiedEmail" />
                    <button type="submit" class="btn-mini">@T("Resend verification email")</button>
                </form>
            </div>
        }

        <form method="post" class="stack-form">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <div class="field">
                <label asp-for="Input.Email">@T("Email")</label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">@T("Password")</label>
                <div class="password-wrap">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <button type="button" class="password-toggle" aria-label="Show password">Show</button>
                </div>
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>
            <button class="btn primary-action full-width" type="submit">@T("Sign in")</button>
        </form>

        <p class="auth-switch">@T("New here?") <a href="/Register">@T("Create an account")</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
