@page
@model RegisterModel
@{
    ViewData["Title"] = "Join";
}

<div class="auth-page page-shell">
    <div class="auth-card">
        <h1>Join HikeJordan</h1>
        <p class="auth-sub">Create a profile to post trips, follow hikers, and save places.</p>

        <form method="post" class="stack-form">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <div class="field">
                <label asp-for="Input.Name">Display name</label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Username">Username</label>
                <input asp-for="Input.Username" class="form-control" />
                <span asp-validation-for="Input.Username" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <button type="submit" class="btn primary-action full-width">Create account</button>
        </form>

        <p class="auth-switch">Already have an account? <a href="/Login">Sign in</a></p>
    </div>
</div>
